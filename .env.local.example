# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only. NEVER expose to the client / commit to git.
# Used by Edge Functions & admin scripts.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ID toko default (salin dari tabel `stores` setelah menjalankan migrasi SQL).
# Dipakai RLS agar seluruh baris hanya milik 1 toko (MVP single-store).
NEXT_PUBLIC_STORE_ID=

# Midtrans (QRIS dinamis). Kosongkan untuk mode simulasi (mock QR).
# Server-only. NEVER expose to the client / commit to git.
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxx

# Pilih gateway QRIS: "midtrans" (default) atau "gopay".
# QRIS_GATEWAY=midtrans

# GoPay Merchant (alternatif) — QRIS standar, settlement ke GoPay.
# Server-only. NEVER expose to the client / commit to git.
# GOPAY_MERCHANT_KEY=xxxxxx
